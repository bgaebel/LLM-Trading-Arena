# Copy .env.example to .env. Never paste keys in chat or screenshots.
# Only OpenAI / Anthropic API keys. NO BITVAVO ACCOUNT KEY NEEDED.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Bitvavo standard EUR spot tier (2026-11-05): taker 0.25%, maker 0.15%.
# Sandbox models immediate taker fills only; no unrealistic maker fills.
TAKER_FEE=0.0025
SLIPPAGE=0.0003
PORT=8787
MARKET_POLL_SECONDS=5
LLM_MIN_INTERVAL_SECONDS=1800
LLM_EVENT_MOVE_THRESHOLD=0.018
LLM_EVENT_COOLDOWN_SECONDS=600
MAX_DAILY_LLM_CALLS=60
