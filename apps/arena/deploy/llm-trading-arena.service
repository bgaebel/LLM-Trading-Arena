[Unit]
Description=LLM Trading Arena research-only paper trading
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__PI_USER__
Group=__PI_USER__
WorkingDirectory=/home/__PI_USER__/llm-trading-arena/apps/arena
Environment=PYTHONUNBUFFERED=1
Environment=TZ=UTC
Environment=LLM_TRADING_ARENA_DATA_DIR=/home/__PI_USER__/.local/share/llm-trading-arena
ExecStartPre=/usr/bin/python3 /home/__PI_USER__/llm-trading-arena/apps/arena/scripts/preflight.py
ExecStart=/usr/bin/python3 /home/__PI_USER__/llm-trading-arena/apps/arena/main.py start
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/__PI_USER__/.local/share/llm-trading-arena
LogNamespace=llm-trading-arena

[Install]
WantedBy=multi-user.target
